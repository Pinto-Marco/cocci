# Copy to .env. The same file is used on the server (/home/ec2-user/.env),
# where it is passed to the container with --env-file.

# Local development only. Unset/False everywhere else.
DEBUG=True

# Required whenever DEBUG is off — Django refuses to start without it.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Defaults to <repo>/db.sqlite3 locally; the image sets /app/db/db.sqlite3.
# DB_PATH=

# Order notification emails (Gmail app password, not the account password).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SHOP_OWNER_EMAIL=
